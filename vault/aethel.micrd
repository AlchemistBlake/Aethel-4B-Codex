{"base":{"P_day_kPa":108.4,"R_specific":287.05,"T_day_K":304.15,"T_night_K":282.15,"T_polar_K":264.15,"aquifer_head_m":180,"core_migration_km":410,"f0_day_Hz":64.4,"g_earth_ms2":9.80665,"gale_wind_ms":48,"gamma":1.4,"kolvax_f0_Hz":112.5,"kolvax_home_G":1.6,"mantle_T_K":368.15,"mass_earth":1.12,"midnight_lock_hours":3,"polar_B_day_mT":6.2,"polar_B_night_mT":18.4,"radius_earth":1.033,"rho_water":1025,"rotation_hours":28.4,"terminator_half_width_cycle":0.02,"tidal_delta_G":0.2,"zones":{"aquifer-siphon":{"depth_m":600,"water":"draining mineral water"},"canopy":{"sheltered":false},"citadel-breach":{"heat":"scalding sulfidic steam","invader_hum":true,"still_air":true,"water":"brine flood"},"citadel-intake":{"heat":"scalding sulfidic steam","invader_hum":true,"sheltered":true,"still_air":true,"water":"flooded water-jacket"},"karst-vault":{"depth_m":400,"sheltered":true},"mantle-shear":{"T_K":368.15,"depth_m":4500,"heat":"geothermal","sheltered":true},"polar-caldera":{"T_K":264.15,"flux":true},"surface-killing-floor":{"sheltered":false},"terminator-gorge":{"sheltered":false}}},"canon":{"P_day_kPa":108.4,"P_night_kPa":159.4,"aquifer_600m_kPa":7698.26,"c_day_ms":349.6,"c_night_ms":336.7,"c_polar_ms":325.8,"c_terminator_ms":343.1,"delta_g_ms2":1.96133,"dusk_inflection_P_kPa":133.9,"dusk_inflection_g_ms2":10.29698,"f0_day_Hz":64.4,"f0_mantle_Hz":31.6,"f0_night_Hz":94.8,"f0_polar_Hz":128.8,"f0_terminator_Hz":79.6,"g0_ms2":10.29698,"g_day_G":0.85,"g_day_ms2":8.33565,"g_night_G":1.25,"g_night_ms2":12.25831,"gravity_gradient_terminator_ms2":3.92266,"pressure_cliff_kPa":51,"rho_day":1.24,"rho_night":1.96,"rho_polar_night":2.12,"rho_terminator":1.6,"scale_height_contraction_pct":36.6,"surge_pct":47.06},"id":"laws.world","kind":"laws","namespace":"96⁷-Alchemic-OS-Blake.ENG","plane":"C","source":{"document":"Aethel-4B","lines":[14,179]},"subject":"world.aethel-4b"}
{"aliases":["Baryon-Spike","the citadel","the Spike","the Kolvax tower"],"canon":["A sky-dropped citadel of black iron that looms like a mile-high mountain; red runes run along its outer wall.","Its core-shaft pounds an offworld carrier hum that never shifts with the sun or the dark star.","It bores toward the deep shear-zone to pin the planet's migrating heart; its upper launch-bays release Null-Gyro flyers.","Its runes flicker from gold to crimson when it overheats."],"exits":["location.spike-cooling-trench","location.eastern-fault-ramp"],"id":"location.baryon-spike","kind":"location","plane":"B","source_lines":[89,129,216,218,241],"title":"The Kolvax Baryon-Spike","zone":"surface-killing-floor"}
{"aliases":["the fault-ramp","eastern fault","fault-corridor"],"canon":["The corridor down which the Kolvax patrols bound toward the sinkhole, and down which the Leviathan was steered.","Now a rolling trench of pulverized stone, crushed tungsten plate and spilled mercury pearls."],"exits":["location.spire-seven-terminator-gorge","location.baryon-spike","location.spike-cooling-trench"],"id":"location.eastern-fault-ramp","kind":"location","plane":"B","source_lines":[89,160,166,200,203],"title":"Eastern Fault-Ramp","zone":"surface-killing-floor"}
{"aliases":["the deep vaults","vault-holds","karst vaults"],"body":"codex/world/altitude-pressure-faction-matrix.md","body_bytes":1646,"body_sha256":"33df4fc05834818ea302f364f42ee631898a86f25e3a5365a8edb33c27a3e386","canon":["Deep-karst Vault-Holds of the Khor-Gron behind gravity-counterweighted basalt airlock plugs; the deeper the vault, the higher the clan's standing.","The airlocks seal before dawn; dawn decompression boils unprotected Khor-Gron blood."],"exits":["location.vault-four","location.perovskite-shear-zone"],"id":"location.karst-vault-stratum","kind":"location","plane":"B","source_lines":[226,227,228,540],"title":"Hyper-Baric Karst Vault Stratum","zone":"karst-vault"}
{"aliases":["shear-zone","deep shear-zone","brood-fault","the deep faults"],"body":"codex/world/altitude-pressure-faction-matrix.md","body_bytes":1646,"body_sha256":"33df4fc05834818ea302f364f42ee631898a86f25e3a5365a8edb33c27a3e386","canon":["Far below the vaults, the migrating core grinds the lower plates into rivers of glowing slag; the Osmir-Dreg trudge there on diamond augers.","Kolvax Baryon-Drill tips bore toward it; Magma-Borer Wyrms and dormant Leviathan broods sleep there."],"exits":["location.karst-vault-stratum"],"id":"location.perovskite-shear-zone","kind":"location","plane":"B","source_lines":[542,543,544],"title":"Perovskite Core-Tide Shear Stratum","zone":"mantle-shear"}
{"aliases":["polar calderas","the calderas"],"body":"codex/races/06-auror-sith.md","body_bytes":8421,"body_sha256":"b7c7e0fc816bd35fcb19df052a7bccda0064989110d6dad3b58af1eea127eba3","canon":["Concentric rings of magnetite pillars, frozen heavy-water glaciers and permanent auroral curtains where the dark star's flux converges.","Home of the Auror-Sith; the further from the poles they travel, the weaker their magnetic relief."],"exits":[],"id":"location.polar-calderas","kind":"location","plane":"B","source_lines":[367,368,371],"title":"Polar Magnetar Calderas","zone":"polar-caldera"}
{"aliases":["relay tower","signal-pylon","sky-dish","relay pylon"],"canon":["A broken Kolvax signal-pylon clinging to the cliff wall above the gorge, with a sky-dish the Cantor's glass roots could splice."],"exits":["location.spire-seven-terminator-gorge"],"id":"location.relay-pylon","kind":"location","plane":"B","source_lines":[185,187],"title":"Broken Signal-Pylon","zone":"terminator-gorge"}
{"aliases":["Sinkhole Four","the sinkhole","the drained sinkhole"],"canon":["A karst throat that swallows the draining whirlpool at dusk and drags careless surface-eels down into the dark aquifers.","Once the water is gone, its dry limestone lip becomes a door for Sinkhole Crawlers and, at the deepest hour, the Nadir-Leviathan.","The Kolvax set a drill tripod on its lip; the Leviathan broke it on the way east."],"exits":["location.spire-seven-terminator-gorge","location.vault-four"],"id":"location.sinkhole-four","kind":"location","plane":"B","source_lines":[82,98,101,115,154,156],"title":"Sinkhole Four","zone":"aquifer-siphon"}
{"aliases":["cooling trench","the trench","cooling sump","the breach"],"canon":["Where the Leviathan smashed through the Spike's lower blast skirt, four tungsten-alloy cooling pipes as thick as mangrove roots run beneath the wall.","The ruptured sump is flooded with freezing subterranean brine and boiling sulfidic coolant under a cloud of yellow-white steam.","Baryon-Nine's augers turned a ring of the foundation into bubbling gray mire."],"exits":["location.spike-intake-tunnel","location.baryon-spike","location.eastern-fault-ramp"],"id":"location.spike-cooling-trench","kind":"location","plane":"B","source_lines":[218,219,220,224,228],"title":"Spike Cooling Trench","zone":"citadel-breach"}
{"aliases":["intake tunnel","water-jacket","the pipe","inner water-jacket"],"canon":["The flooded black mouth of a burst water-jacket, a throat of pipe leading inside the Baryon-Spike.","The main ballast locks lie a short swim up the tunnel; sulfur gas fills it, deadly to a flyer's lungs.","Cloning vats feed it: heartbeats heavy as vault-guards march through the inner water-jacket."],"exits":["location.spike-cooling-trench"],"id":"location.spike-intake-tunnel","kind":"location","plane":"B","source_lines":[233,303,318],"title":"Spike Intake Tunnel","zone":"citadel-intake"}
{"aliases":["Spire-Seven","the great tree","the mangrove"],"canon":["A Basalt-Mangrove Mega-Spire: a hollow silicate tree whose heartwood pumps mineral water skyward by day.","At dusk its upper bark-shutters clap shut like drawbridges and the Hydrological Drain roars down through the trunk.","Its lowest external tariff-shelf is where Sera-Vash weighs cargo; the bark there grows thick and iron-hard against the night storms.","An exterior vascular root-stair descends its trunk to the canyon floor."],"exits":["location.spire-seven-terminator-gorge","location.zenith-canopy"],"id":"location.spire-seven","kind":"location","plane":"B","source_lines":[58,60,69,80,82,124],"title":"Spire-Seven","zone":"canopy"}
{"aliases":["the gorge","canyon floor","the canyon","drained basin"],"canon":["A grooved basalt canyon floor below Spire-Seven, scored with carved piton-grooves for riding out the gale.","The Dusk Terminator strikes its rim as a screaming wall of silica dust; the temperature falls in a few breaths.","Its walls carry a native chord well; voices bound together roll down them like a landslide."],"exits":["location.spire-seven","location.sinkhole-four","location.vault-four","location.eastern-fault-ramp","location.relay-pylon"],"id":"location.spire-seven-terminator-gorge","kind":"location","plane":"B","source_lines":[85,86,87,152],"title":"Spire-Seven Terminator Gorge","zone":"terminator-gorge"}
{"aliases":["Vault Four","the airlock","the vault"],"canon":["A deep vault sealed by a forty-ton basalt plug that grinds upward on counterweighted chains, venting warm rust-scented air.","Harvest crews climb out of it on chain-hoists once the water has drained."],"exits":["location.spire-seven-terminator-gorge","location.karst-vault-stratum"],"id":"location.vault-four","kind":"location","plane":"B","source_lines":[93,112],"title":"Vault Four","zone":"karst-vault"}
{"aliases":["the canopy","sun-crowns","upper canopy"],"body":"codex/world/altitude-pressure-faction-matrix.md","body_bytes":1646,"body_sha256":"33df4fc05834818ea302f364f42ee631898a86f25e3a5365a8edb33c27a3e386","canon":["The high sunlit crowns of the mangrove spires, ruled by Aethel-Vael triads who sing laws across the canopy at noon.","At night the flyers lock spine-to-spine in suspended carbon-silk cocoons, helpless while the world groans beneath them."],"exits":["location.spire-seven"],"id":"location.zenith-canopy","kind":"location","plane":"B","source_lines":[31,47,65,531],"title":"Zenith Canopy Stratum","zone":"canopy"}
